---
import { getAbsoluteLocaleUrl } from "astro:i18n";
import "../styles/global.css";
import { getLocale, locales } from "../i18n/ui";

interface Props {
  title: string;
}

const { title } = Astro.props;
const locale = getLocale(Astro.currentLocale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {
      locales.map((code) => (
        <link
          rel="alternate"
          hreflang={code}
          href={getAbsoluteLocaleUrl(code)}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl("en")} />
    <link
      rel="preload"
      href="/fonts/inter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      // Polish body text also needs the Latin Extended-A glyphs.
      locale === "pl" && (
        <link
          rel="preload"
          href="/fonts/inter-latin-ext-a.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
