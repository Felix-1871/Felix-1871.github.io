---
import "../styles/global.css";
import { getLocale } from "../i18n/ui";

interface Props {
  title: string;
}

const { title } = Astro.props;
const locale = getLocale(Astro.currentLocale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
    <link
      rel="preload"
      href="/fonts/inter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      // Polish body text also needs the Latin Extended-A glyphs.
      locale === "pl" && (
        <link
          rel="preload"
          href="/fonts/inter-latin-ext-a.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
