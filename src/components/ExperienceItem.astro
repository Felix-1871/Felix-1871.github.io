---
import type { LocalizedCv } from "../i18n/cv";
import DateRange from "./DateRange.astro";
import Localized from "./Localized.astro";

type Props = LocalizedCv["experience"][number];

const { title, organisation, location, start, end, achievements } = Astro.props;
---

<li>
  <p>
    <span class="title"><Localized text={title} /></span>, {organisation}
  </p>
  <p class="meta">
    <DateRange start={start} end={end} />, <Localized text={location} />
  </p>
  <ul>
    {
      achievements.map((achievement) => (
        <li>
          <Localized text={achievement} />
        </li>
      ))
    }
  </ul>
</li>

<style>
  ul {
    margin-block-start: var(--space-xs);
    padding-inline-start: var(--space-m);
    list-style-type: disc;
  }

  ul li + li {
    margin-block-start: var(--space-3xs);
  }

  ul li::marker {
    color: var(--text-muted);
  }
</style>
