---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { LocalizedCv } from "../i18n/cv";
import { getLocale, languageNames, locales, ui } from "../i18n/ui";
import Localized from "./Localized.astro";

type Props = Pick<LocalizedCv, "name" | "role" | "summary">;

const { name, role, summary } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = ui[locale];
---

<header>
  <ul class="languages">
    {
      locales.map((code) => (
        <li>
          <a
            href={getRelativeLocaleUrl(code)}
            hreflang={code}
            lang={code}
            aria-current={code === locale ? "page" : undefined}
          >
            {languageNames[code]}
          </a>
        </li>
      ))
    }
  </ul>
  <h1>{name}</h1>
  <p class="role"><Localized text={role} /></p>
  <p class="summary"><Localized text={summary} /></p>
  <p class="actions">
    <a href="#contact">{t.getInTouch}</a>
    <a href={`/cv/cv-${locale}.pdf`} download>{t.downloadCv}</a>
  </p>
  <nav>
    <ul>
      {
        Object.entries(t.sections).map(([id, heading]) => (
          <li>
            <a href={`#${id}`}>{heading}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-s);
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
  }

  .languages {
    margin-block-end: var(--space-l);
  }

  [aria-current="page"] {
    color: var(--text);
    text-decoration: none;
  }

  h1 {
    font-size: var(--step-5);
    line-height: var(--leading-tight);
  }

  .role {
    margin-block-start: var(--space-xs);
    font-size: var(--step-1);
    line-height: var(--leading-snug);
  }

  .summary {
    margin-block-start: var(--space-2xs);
    color: var(--text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    margin-block-start: var(--space-m);
  }

  nav {
    margin-block-start: var(--space-l);
  }

  @media print {
    .languages,
    .actions,
    nav {
      display: none;
    }
  }
</style>
