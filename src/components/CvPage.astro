---
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import DateRange from "../components/DateRange.astro";
import ExperienceItem from "../components/ExperienceItem.astro";
import Header from "../components/Header.astro";
import Section from "../components/Section.astro";
import { ui } from "../i18n/ui";

const entry = await getEntry("cv", "en");
if (!entry) {
  throw new Error("No English CV found. Add src/content/cv/en.yaml.");
}
const cv = entry.data;
const t = ui.en;
---

<Base title={cv.name}>
  <a class="skip-link" href="#main">{t.skipLink}</a>
  <Header name={cv.name} role={cv.role} summary={cv.summary} />
  <main id="main">
    <Section id="about">
      <p>{cv.about}</p>
    </Section>

    <Section id="experience">
      <ol class="entries">
        {cv.experience.map((item) => <ExperienceItem {...item} />)}
      </ol>
    </Section>

    <Section id="work">
      <ul class="entries">
        {
          cv.work.map(({ name, description, role, url }) => (
            <li>
              <p class="title">
                <a href={url}>{name}</a>
              </p>
              <p>{description}</p>
              <p class="meta">{role}</p>
            </li>
          ))
        }
      </ul>
    </Section>

    <Section id="skills">
      <dl>
        {
          cv.skills.map(({ name, items }) => (
            <>
              <dt>{name}</dt>
              <dd>
                <ul class="skills">
                  {items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </dd>
            </>
          ))
        }
      </dl>
    </Section>

    <Section id="education">
      <ol class="entries">
        {
          cv.education.map(({ title, institution, start, end }) => (
            <li>
              <p>
                <span class="title">{title}</span>, {institution}
              </p>
              <p class="meta">
                <DateRange start={start} end={end} />
              </p>
            </li>
          ))
        }
      </ol>
    </Section>

    <Section id="languages">
      <dl>
        {
          cv.languages.map(({ name, level }) => (
            <>
              <dt>{name}</dt>
              <dd>{level}</dd>
            </>
          ))
        }
      </dl>
    </Section>

    <Section id="contact">
      <p>{cv.contact.intro}</p>
      <address>
        <ul class="contact">
          <li>
            <a href={`mailto:${cv.contact.email}`}>{cv.contact.email}</a>
          </li>
          <li><a href={cv.contact.linkedin}>LinkedIn</a></li>
          <li><a href={cv.contact.github}>GitHub</a></li>
          <li>
            <a href={cv.contact.business.url}>{cv.contact.business.name}</a>
          </li>
        </ul>
      </address>
    </Section>
  </main>
</Base>

<style>
  .skip-link {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: var(--gutter);
    padding: var(--space-2xs) var(--space-xs);
    background: var(--bg);
    translate: 0 -100%;
  }

  .skip-link:focus {
    translate: none;
  }

  dt {
    font-weight: 600;
  }

  dd + dt {
    margin-block-start: var(--space-s);
  }

  .skills {
    padding: 0;
    list-style: none;
  }

  .skills li {
    display: inline;
  }

  .skills li:not(:last-child)::after {
    content: ", ";
  }

  address {
    margin-block-start: var(--space-s);
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    padding: 0;
    list-style: none;
  }
</style>
